# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#

# Force QIO flash for maximum performance
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Number of HID peripherals:
CONFIG_TINYUSB_HID_COUNT=1

# Improve performance
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# SPIFFS profile storage (used when CONFIG_MACRO_WEB_UI is enabled in menuconfig)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Web UI: WebSocket for live status; HTTP for profile load/upload
CONFIG_HTTPD_WS_SUPPORT=y

# HTTP server + browser refresh (aborted TCP pcbs need headroom + fast TIME_WAIT)
CONFIG_LWIP_MAX_SOCKETS=32
CONFIG_LWIP_MAX_ACTIVE_TCP=16
CONFIG_LWIP_PBUF_POOL_SIZE=48
CONFIG_LWIP_MEM_SIZE=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_MSL=3000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=3000

# HID + TinyUSB share CPU1; SPI/Wi-Fi use CPU0
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
