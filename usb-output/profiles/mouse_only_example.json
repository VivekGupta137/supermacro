{
  "v": 1,
  "name": "mouse-only-sample",
  "groups": [
    {
      "comment": "Hold side forward (0x10): slow drift up-left, repeats while held",
      "steps": [
        { "us": 3000, "mouse": { "x": -2, "y": -2 } },
        { "us": 3000, "mouse": { "x": -2, "y": -2 } },
        { "us": 3000, "mouse": { "x": -2, "y": -2 } }
      ],
      "n": 3,
      "loop": true,
      "press": { "mouse": { "b": 16 } }
    },
    {
      "comment": "Hold right button: small horizontal jog, repeats while held",
      "steps": [
        { "us": 5000, "mouse": { "x": 3, "y": 0 } },
        { "us": 5000, "mouse": { "x": -3, "y": 0 } }
      ],
      "n": 2,
      "loop": true,
      "press": { "mouse": { "b": 2 } }
    },
    {
      "comment": "Hold left+right together: clockwise square pattern while both are held",
      "steps": [
        { "us": 7000, "mouse": { "x": 2, "y": 0 } },
        { "us": 7000, "mouse": { "x": 0, "y": 2 } },
        { "us": 7000, "mouse": { "x": -2, "y": 0 } },
        { "us": 7000, "mouse": { "x": 0, "y": -2 } }
      ],
      "n": 4,
      "loop": true,
      "press": { "mouse": { "b": 3 } }
    },
    {
      "comment": "Middle click (wheel click): three notches down (wheel is int8)",
      "steps": [
        { "us": 40000, "mouse": { "w": -1 } },
        { "us": 40000, "mouse": { "w": -1 } },
        { "us": 40000, "mouse": { "w": -1 } }
      ],
      "n": 3,
      "loop": false,
      "press": { "mouse": { "b": 4 } }
    },
    {
      "comment": "Back button (0x08): single tap sends no movement (clears state step)",
      "steps": [
        { "us": 10000, "mouse": {} }
      ],
      "n": 1,
      "loop": false,
      "press": { "mouse": { "b": 8 } }
    }
  ]
}
