# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#

# (From USB template)
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# Slightly longer hub/port timing — helps flaky CHECK_ADDR on downstream ports
CONFIG_USB_HOST_DEBOUNCE_DELAY_MS=300
CONFIG_USB_HOST_SET_ADDR_RECOVERY_MS=30
CONFIG_USB_HOST_RESET_RECOVERY_MS=50

# Force QIO flash for maximum performance
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# Improve performance
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
